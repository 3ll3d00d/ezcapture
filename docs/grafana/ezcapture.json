{
  "title": "ezcapture",
  "uid": "ezcapture",
  "tags": [
    "ezcapture",
    "capture"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "filter",
        "label": "Filter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(ezcapture_video_signal_info, filter)",
        "query": {
          "query": "label_values(ezcapture_video_signal_info, filter)",
          "refId": "filter"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Video input",
      "description": "The signal arriving at the capture card.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_video_signal_info{filter=~\"$filter\"} == 1",
          "legendFormat": "{{in_resolution}} @ {{in_fps}}  {{in_pixel_layout}}  {{in_bit_depth}}-bit  {{in_colour_format}}  {{in_quantisation}}",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Video output",
      "description": "The format sent to the renderer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_video_signal_info{filter=~\"$filter\"} == 1",
          "legendFormat": "{{out_resolution}} @ {{out_fps}}  {{out_pixel_format}}  {{out_bit_depth}}-bit  {{out_transfer_function}}",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Audio",
      "description": "The current audio input and what is sent to the renderer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_audio_signal_info{filter=~\"$filter\"} == 1",
          "legendFormat": "{{out_codec}}  {{out_sample_rate}} Hz  {{out_bit_depth}}-bit  {{out_channels}}ch {{out_channel_layout}}",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "HDR MaxCLL",
      "description": "MaxCLL of the current content. 0 means there is no HDR metadata.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_hdr_max_cll_nits{filter=~\"$filter\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "nits",
          "custom": {},
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "HDR MaxFALL",
      "description": "MaxFALL of the current content. 0 means there is no HDR metadata.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_hdr_max_fall_nits{filter=~\"$filter\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "nits",
          "custom": {},
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Mastering peak",
      "description": "Peak luminance of the mastering display. 0 means there is no HDR metadata.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_hdr_max_mastering_luminance_nits{filter=~\"$filter\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "nits",
          "custom": {},
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Delivered FPS",
      "description": "Video frame rate actually delivered over the last ~1.5s. Compare with the input rate above.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_video_measured_fps{filter=~\"$filter\"} and on(filter, in_sig, out_sig) (ezcapture_video_signal_info{filter=~\"$filter\"} == 1)",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {},
          "mappings": [],
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "FPS spread (5m)",
      "description": "Highest minus lowest delivered FPS over 5 minutes. A steady signal stays close to 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time(ezcapture_video_measured_fps{filter=~\"$filter\"}[5m]) - min_over_time(ezcapture_video_measured_fps{filter=~\"$filter\"}[5m])",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {},
          "mappings": [],
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Worst conversion, % of frame",
      "description": "Slowest conversion in the last ~1.5s as a share of one frame's time. At 100% the filter can't keep up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_frame_latency_window_seconds{stream=\"video\", stage=\"conversion\", filter=~\"$filter\", stat=\"max\"} * on(filter, in_sig, out_sig) ezcapture_video_measured_fps{filter=~\"$filter\"} and on(filter, in_sig, out_sig) (ezcapture_video_signal_info{filter=~\"$filter\"} == 1)",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {},
          "mappings": [],
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Conversion p95 (5m)",
      "description": "95% of frames converted faster than this over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ezcapture_frame_latency_seconds_bucket{stream=\"video\", stage=\"conversion\", filter=~\"$filter\"}[5m])))",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {},
          "mappings": [],
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Signal history",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "state-timeline",
      "title": "Video signal",
      "description": "Each row is one input and output format pair, filled while it is the current signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_video_signal_info{filter=~\"$filter\"} == 1",
          "legendFormat": "{{in_sig}} > {{out_sig}}",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "active",
                  "color": "blue"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Frame rate and headroom",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Delivered frame rate",
      "description": "Dips show frames that were not delivered on time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_video_measured_fps{filter=~\"$filter\"} and on(filter, in_sig, out_sig) (ezcapture_video_signal_info{filter=~\"$filter\"} == 1)",
          "legendFormat": "{{in_sig}}",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Conversion, % of frame time",
      "description": "How much of each frame's time goes on conversion. Max above 100% means a late frame.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_frame_latency_window_seconds{stream=\"video\", stage=\"conversion\", filter=~\"$filter\", stat=\"mean\"} * on(filter, in_sig, out_sig) ezcapture_video_measured_fps{filter=~\"$filter\"} and on(filter, in_sig, out_sig) (ezcapture_video_signal_info{filter=~\"$filter\"} == 1)",
          "legendFormat": "mean",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ezcapture_frame_latency_window_seconds{stream=\"video\", stage=\"conversion\", filter=~\"$filter\", stat=\"max\"} * on(filter, in_sig, out_sig) ezcapture_video_measured_fps{filter=~\"$filter\"} and on(filter, in_sig, out_sig) (ezcapture_video_signal_info{filter=~\"$filter\"} == 1)",
          "legendFormat": "max",
          "refId": "B",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [],
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
